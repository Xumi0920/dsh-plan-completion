{
  "name": "dsh-plan-completion",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Implicit session plans with Tab-completable next-message suggestions for DeepSeek Harness",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "session-plan",
    "suggestion"
  ],
  "author": "XM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xumi0920/dsh-plan-completion.git"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "test": "node --test",
    "check:package": "node scripts/check-package.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./observer": "./host/observer.js",
    "./generator": "./host/generator.js",
    "./retrieval": "./host/retrieval.js",
    "./api": "./host/api.js"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/managed-embedding.md",
    "docs/security.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
